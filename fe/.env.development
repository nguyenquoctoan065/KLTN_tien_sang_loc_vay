# false (mặc định): gọi backend thật qua proxy /api -> http://localhost:8080 ; true: API giả lập trong trình duyệt (MSW).
# Bật mock không cần sửa file này (biến môi trường có sẵn được Vite ưu tiên hơn file .env):
#   $env:VITE_USE_MOCK="true"; npm run dev
# hoặc tạo fe/.env.development.local (đã nằm trong .gitignore) chứa VITE_USE_MOCK=true.
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
